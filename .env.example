# ── Required ──────────────────────────────────────────────────────────────
# Agent wallet private key (base58). Must have a USDC ATA on Solana mainnet
# (first USDC transfer auto-creates it). BridgeNode sponsors gas fees.
SOLANA_PRIVATE_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# Solana RPC endpoint used for payment settlement (default: mainnet-beta).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# BridgeNode endpoint (default: https://bridgenode.cc/v1).
# Origin-pinned: HTTPS + exactly bridgenode.cc — other hosts/schemes are rejected.
BRIDGENODE_BASE_URL=https://bridgenode.cc/v1

# BridgeNode USDC receiving wallet (default: BridgeNode mainnet wallet).
# Payments are only ever signed to this address (recipient pin).
BRIDGENODE_PAY_TO=BHMDv3ri3LBEZjEzJgDZeUiguVX7LmsCstTXbM3dL8rN

# Max USDC per transaction (default: 1). Safety cap — user configurable.
# Exactly "0" disables the cap; malformed values fail closed.
BRIDGENODE_MAX_USDC_PER_TX=1
