{
  "name": "@bridgenode/openclaw-plugin-x402",
  "version": "0.1.0",
  "description": "OpenClaw tool plugin for pay-per-request LLM inference via x402 on Solana USDC — no API keys, no accounts, gas sponsored",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "openclaw",
    "x402",
    "solana",
    "usdc",
    "ai",
    "inference",
    "llm",
    "payment",
    "pay-per-request",
    "mcp"
  ],
  "license": "MIT-0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bridgenode-ai/openclaw-plugin-x402.git"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@solana/kit": "^8.0.0",
    "@x402/core": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "@x402/svm": "^2.25.0",
    "bs58": "^6.0.0",
    "typebox": "^1.3.27"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "^2026.9.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run plugin:build && openclaw plugins validate --entry ./dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run plugin:validate"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
